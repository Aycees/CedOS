# Ced OS environment.
#
# Development runs against the Supabase CLI local stack (`pnpm db:start`),
# which prints these values on startup. Never develop against production —
# habit and finance data is not reproducible (system design §7).
#
# Copy to `.env` and fill in from `supabase start` output.

# Postgres. Prisma connects as a privileged role and BYPASSES row-level
# security, which is why the app layer is the primary security boundary:
# every query goes through core/db/scope.ts with an explicit userId.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54422/postgres"

# Supabase Auth. The anon key is public by design and safe in the browser;
# RLS is deny-all on every table so a leaked key reads nothing.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54421"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Shared secret for the retention cron (GET /api/cron/purge-events). Whatever
# scheduler calls it must send `Authorization: Bearer <this value>`.
CRON_SECRET=""
